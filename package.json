{
  "name": "research-importer",
  "version": "2.0.0",
  "description": "Obsidian plugin – Research Literature Manager",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "install-plugin": "node -e \"if(!process.env.VAULT_PLUGIN_DIR){console.error('Set VAULT_PLUGIN_DIR to the plugin folder of your vault');process.exit(1)}\" && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit -p .",
    "test": "node tests/run.mjs"
  },
  "keywords": [],
  "author": "Alberto Mercurio",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "0.21.5",
    "obsidian": "latest",
    "tslib": "2.6.2",
    "typescript": "5.4.5"
  },
  "dependencies": {
    "mathml-to-latex": "^1.5.0"
  }
}
